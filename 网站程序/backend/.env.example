# V5 后端配置
PORT=8787

# 正式绑定域名后填写，例如：https://www.your-domain.com
# 不填写时，后端会根据当前访问域名自动生成 robots.txt 和 sitemap.xml
SITE_ORIGIN=

# 正式上线建议一定设置，用于 admin.html /api/leads /api/leads.csv 读取保护
ADMIN_TOKEN=change-this-admin-token

# 可选：新线索推送到飞书 / 企业微信 / 自定义 Webhook
# 飞书机器人示例：WEBHOOK_TYPE=feishu
# 企业微信机器人示例：WEBHOOK_TYPE=wecom
# 通用 JSON 推送：WEBHOOK_TYPE=generic
WEBHOOK_URL=
WEBHOOK_TYPE=generic

# 是否允许未设置 ADMIN_TOKEN 时读取后台数据
ALLOW_OPEN_ADMIN_WHEN_NO_TOKEN=true


# V11 正式上线安全建议
# 正式上线请设置一个长密钥，并关闭无密钥开放后台
ADMIN_TOKEN=change-this-to-a-long-random-token
ALLOW_OPEN_ADMIN_WHEN_NO_TOKEN=false

# 表单防刷：同一 IP 10 分钟最多提交 5 次
RATE_WINDOW_MS=600000
RATE_MAX_LEADS=5
